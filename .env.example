# ────────────────────────────────────────────────
# Required
# ────────────────────────────────────────────────
# Note the +asyncpg suffix — this code uses async sqlalchemy
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# MUST be a strong random string. Bot refuses to start with default token
# AND a public host (0.0.0.0). Set this BEFORE deploying.
API_TOKEN=change-this-to-a-strong-random-string
API_HOST=0.0.0.0   # Railway needs this; for local-only use 127.0.0.1

# ────────────────────────────────────────────────
# CORS for /api endpoints (default: same-origin only)
# Set to "*" for local dev, or specific origins for production
# ────────────────────────────────────────────────
API_ALLOWED_ORIGINS=

# ────────────────────────────────────────────────
# Live trading 3-stage gate (ALL must be true to send orders)
# ────────────────────────────────────────────────
# Stage 1: don't even import the SDK
LIVE_CODE_ENABLED=false
# Stage 2: SDK initialization (needs keys)
ENABLE_LIVE=false
# Stage 3: live_armed in DB — toggle via API/dashboard
# (no env var; defaults to false on every restart)

# ────────────────────────────────────────────────
# Live safety (only used when live capable)
# ────────────────────────────────────────────────
# Until exchange-side stop/TP placement is implemented, KEEP this true
REQUIRE_PROTECTED_EXITS=true
LIVE_MAX_ORDER_USD=500
LIVE_MAX_SLIP_BPS=30
RECONCILE_INTERVAL_S=60

# Use AGENT WALLET, never master private key!
HL_ACCOUNT_ADDRESS=
HL_SECRET_KEY=

# ────────────────────────────────────────────────
# Strategy toggles (also stored in DB; env is startup default)
# ────────────────────────────────────────────────
ENABLE_LIQ_FADE=true
ENABLE_WALL=true

# ────────────────────────────────────────────────
# Coin universe (liquidation_fade trades these)
# ────────────────────────────────────────────────
COINS=BTC,ETH,SOL,HYPE,AVAX,LINK

# ────────────────────────────────────────────────
# Account / sizing
# ────────────────────────────────────────────────
PAPER_BALANCE=1000
RISK_PCT=1.5
MAX_POS=3
MAX_POS_STRAT=2
MAX_POS_COIN=1
MAX_POS_USD=200
MAX_LEV=3.0

# ────────────────────────────────────────────────
# Risk limits
# ────────────────────────────────────────────────
DAILY_LOSS_PCT=5.0
DD_CIRCUIT_PCT=20.0
COIN_COOLDOWN_MIN=30
MAX_CONSEC_LOSSES=3
COIN_STALE_S=60

# ────────────────────────────────────────────────
# WS health
# ────────────────────────────────────────────────
HEARTBEAT_TIMEOUT_S=30

# ────────────────────────────────────────────────
# Observability / debugging
# ────────────────────────────────────────────────
# RAW_WS_LOG=true persists sampled raw WS messages to DB so you can verify
# the liquidation feed shape during the first week of paper testing.
RAW_WS_LOG=false
RAW_WS_SAMPLE_EVERY=100   # 1 of N trades; ALL liquidation-flagged are kept
LOG_LEVEL=INFO

# ────────────────────────────────────────────────
# Liquidation Fade thresholds
# ────────────────────────────────────────────────
LIQ_WINDOW_S=5.0
LIQ_MIN_BTC=500000
LIQ_MIN_ETH=250000
LIQ_MIN_ALT=150000
LIQ_WAIT_S=3.0
LIQ_MAX_AGE_S=12.0
LIQ_SL_ATR=1.5
LIQ_TP_ATR=2.0
LIQ_TIME_S=600

# ────────────────────────────────────────────────
# Liquidity Wall (BTC only)
# ────────────────────────────────────────────────
WALL_MIN_USD=2000000
WALL_MULT=5.0
WALL_TRACK_S=30
WALL_SHRINK_PCT=25.0
WALL_PROX_BPS=5.0
WALL_MIN_HIT=300000
WALL_FLIP_S=10.0
WALL_SL_BPS=15.0
WALL_TP_ATR=1.5
WALL_TIME_S=300

# ────────────────────────────────────────────────
# Endpoints
# ────────────────────────────────────────────────
HL_WS_URL=wss://api.hyperliquid.xyz/ws
HL_REST_URL=https://api.hyperliquid.xyz
